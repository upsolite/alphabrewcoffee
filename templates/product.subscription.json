        "custom_liquid_XUXEMj": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"custom-shipping-container\">\n  <div class=\"custom-shipping-item\">\n    <svg class=\"green-circle\" xmlns=\"http://www.w3.org/2000/svg\" width=\"12\" height=\"13\" viewBox=\"0 0 12 13\" fill=\"none\">\n      <circle cx=\"6\" cy=\"6.5\" r=\"6\" fill=\"#137333\"/>\n    </svg>\n    <div class=\"text-block-shipping\">Ships by <span id=\"shipping-date\" class=\"shipping-date\"></span></div>\n  </div>\n  <div class=\"custom-shipping-item flags-container\">\n    <img id=\"country-flag\" class=\"custom-icon\" src=\"\" alt=\"Country Flag\">\n    <div id=\"country-text\" class=\"shipping-worldwide\"></div>\n  </div>\n</div>\n\n<style>\n  .custom-shipping-container {\n    display: flex;\n    padding: 8px 16px;\n    justify-content: space-between;\n    align-items: center;\n    background-color: #f6f6f6;\n    border-radius: 20px;\n    margin-top: 10px;\n    width: 100%;\n    box-sizing: border-box;\n  }\n  .custom-shipping-item {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n  }\n  .text-block-shipping {\n    font-size: 12px;\n    color: #000;\n    white-space: nowrap;\n  }\n  .shipping-date {\n    font-weight: bold;\n  }\n  .shipping-worldwide {\n    font-size: 12px;\n    color: #000;\n    white-space: nowrap;\n  }\n  .shipping-worldwide .bold {\n    font-weight: bold;\n  }\n  .green-circle {\n    animation: fade 1s ease-in-out infinite;\n    flex-shrink: 0;\n  }\n  @keyframes fade {\n    0%, 100% { opacity: 1; }\n    50% { opacity: 0.5; }\n  }\n  .flags-container {\n    display: flex;\n    gap: 6px;\n    align-items: center;\n  }\n  .custom-icon {\n    width: 16px;\n    height: 12px;\n    flex-shrink: 0;\n  }\n  \n  @media (max-width: 768px) {\n    .custom-shipping-container {\n      padding: 6px 12px;\n    }\n    .text-block-shipping,\n    .shipping-worldwide {\n      font-size: 11px;\n    }\n  }\n</style>\n\n<script>\n  (function() {\n    function getNextWeekday(date) {\n      var day = date.getDay();\n      var daysToAdd = (day === 5) ? 3 : (day === 6) ? 2 : 1;\n      return new Date(date.setDate(date.getDate() + daysToAdd));\n    }\n    \n    var today = new Date();\n    var shipDate = getNextWeekday(today);\n    var options = { weekday: 'short', month: 'long', day: 'numeric' };\n    var formattedDate = shipDate.toLocaleDateString('en-US', options);\n    \n    var dateElement = document.getElementById('shipping-date');\n    if (dateElement) {\n      dateElement.textContent = formattedDate;\n    }\n    \n    // Fetch the visitor's country using an IP geolocation API\n    fetch('https://ipapi.co/json/')\n      .then(response => response.json())\n      .then(data => {\n        var countryCode = data.country_code;\n        var flagUrl = 'https://flagcdn.com/w20/' + countryCode.toLowerCase() + '.png';\n        \n        var flagElement = document.getElementById('country-flag');\n        var textElement = document.getElementById('country-text');\n        \n        if (flagElement) {\n          flagElement.src = flagUrl;\n        }\n        if (textElement) {\n          textElement.innerHTML = 'Fast <span class=\"bold\">' + countryCode + '</span> Shipping';\n        }\n      })\n      .catch(error => {\n        console.error('Error fetching the IP information:', error);\n        // Fallback to US\n        var flagElement = document.getElementById('country-flag');\n        var textElement = document.getElementById('country-text');\n        if (flagElement) {\n          flagElement.src = 'https://flagcdn.com/w20/us.png';\n        }\n        if (textElement) {\n          textElement.innerHTML = 'Fast <span class=\"bold\">US</span> Shipping';\n        }\n      });\n  })();\n</script>"
          }
        },
