        "custom_liquid_yWHx4F": {
          "type": "custom_liquid",
          "disabled": true,
          "settings": {
            "custom_liquid": "<div class=\"st-wrap\">\n  <div class=\"st-card\">\n\n    <p class=\"st-title\">After 90 Days Customer-Reported Results</p>\n\n    <div class=\"st-grid\">\n\n      <div class=\"st-item\">\n        <p class=\"st-label\">Daily Energy</p>\n        <p class=\"st-num\">87%</p>\n        <p class=\"st-desc\">Reported improved daily energy</p>\n      </div>\n\n      <div class=\"st-item\">\n        <p class=\"st-label\">Physical Stamina</p>\n        <p class=\"st-num\">93%</p>\n        <p class=\"st-desc\">Reported improved stamina</p>\n      </div>\n\n      <div class=\"st-item\">\n        <p class=\"st-label\">Mental Focus</p>\n        <p class=\"st-num\">73%</p>\n        <p class=\"st-desc\">Reported improved focus</p>\n      </div>\n\n      <div class=\"st-item\">\n        <p class=\"st-label\">Men's Vitality</p>\n        <p class=\"st-num\">97%</p>\n        <p class=\"st-desc\">Reported improved vitality</p>\n      </div>\n\n    </div>\n\n    <!-- Optional source line: remove the comment markers and fill it in with your real data -->\n    <!-- <p class=\"st-source\">Based on a survey of ___ customers over ___ weeks.</p> -->\n\n  </div>\n</div>\n\n<style>\n  .st-wrap,\n  .st-wrap * {\n    box-sizing: border-box;\n  }\n  .st-wrap {\n    max-width: 1000px;\n    margin: 0 auto;\n    padding: 12px;\n  }\n  .st-card {\n    background: #fbf7ee;           /* card background */\n    border: 2px solid #e6d3b8;     /* card border */\n    border-radius: 16px;\n    padding: 18px 10px 16px;\n    text-align: center;\n    overflow: hidden;\n  }\n  .st-title {\n    margin: 0 0 12px;\n    font-family: inherit;\n    font-size: 12px;\n    font-weight: 600;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n    color: #6b4a1e;                /* deeper shade for readability */\n  }\n  .st-grid {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n  }\n  .st-item {\n    min-width: 0;\n    padding: 2px 10px;\n  }\n  .st-item + .st-item {\n    border-left: 1px solid #e6d3b8;   /* divider between stats */\n  }\n  .st-label {\n    margin: 0 0 4px;\n    font-family: inherit;\n    font-size: 13px;\n    font-weight: 700;\n    line-height: 1.2;\n    color: #6b4a1e;\n  }\n  .st-num {\n    margin: 0 0 4px;\n    font-family: inherit;\n    font-size: 40px;\n    font-weight: 400;\n    line-height: 1;\n    letter-spacing: -.02em;\n    color: #B98141;                /* your gold */\n  }\n  .st-desc {\n    margin: 0 auto;\n    max-width: 170px;\n    font-family: inherit;\n    font-size: 13px;\n    line-height: 1.3;\n    color: #6b4a1e;\n  }\n  .st-source {\n    margin: 12px 0 0;\n    font-family: inherit;\n    font-size: 12px;\n    font-weight: 500;\n    color: #6b4a1e;\n  }\n  @media (max-width: 749px) {\n    .st-wrap { padding: 8px; }\n    .st-card { padding: 12px 4px 12px; border-radius: 12px; }\n    .st-title { font-size: 10px; letter-spacing: .1em; margin-bottom: 10px; }\n    .st-item { padding: 0 5px; overflow-wrap: break-word; }\n    .st-label {\n      font-size: 10.5px;\n      min-height: 2.4em;              /* keeps the numbers lined up */\n      display: flex;\n      align-items: flex-end;\n      justify-content: center;\n    }\n    .st-num { font-size: 26px; margin-bottom: 3px; }\n    .st-desc { font-size: 10px; line-height: 1.25; }\n  }\n</style>"
