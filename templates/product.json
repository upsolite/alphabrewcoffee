        "custom_liquid_QQiQXy": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"nl-wrap\">\n  <button type=\"button\" class=\"nl-btn\" id=\"nlOpen\" aria-haspopup=\"dialog\" aria-controls=\"nlModal\">View Nutrition Label</button>\n</div>\n\n<div class=\"nl-modal\" id=\"nlModal\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Nutrition label\" hidden>\n  <div class=\"nl-panel\">\n    <button type=\"button\" class=\"nl-close\" id=\"nlClose\" aria-label=\"Close nutrition label\">&times;</button>\n    <img class=\"nl-img\" src=\"{{ 'nutrition-label.jpg' | file_url }}\" alt=\"Supplement Facts nutrition label\" loading=\"lazy\">\n  </div>\n</div>\n\n<style>\n  .nl-wrap,\n  .nl-wrap *,\n  .nl-modal,\n  .nl-modal * {\n    box-sizing: border-box;\n  }\n  .nl-wrap {\n    width: 100%;\n    padding: 8px 16px;\n    text-align: left;              /* button sits on the left */\n  }\n  .nl-btn {\n    display: inline-block;\n    margin: 0;\n    padding: 7px 12px;\n    background: #F1E5C2;           /* button color */\n    color: #4a3512;\n    border: 1px solid #d9c896;\n    border-radius: 4px;            /* set to 0 for fully sharp corners */\n    font-family: inherit;\n    font-size: 12px;\n    font-weight: 600;\n    line-height: 1;\n    letter-spacing: .02em;\n    cursor: pointer;\n    -webkit-appearance: none;\n    appearance: none;\n  }\n  .nl-btn:hover { background: #ebdcae; }\n  .nl-btn:focus-visible,\n  .nl-close:focus-visible {\n    outline: 2px solid #B98141;\n    outline-offset: 2px;\n  }\n\n  .nl-modal {\n    position: fixed;\n    inset: 0;\n    z-index: 99999;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 16px;\n    background: rgba(0, 0, 0, .65);\n  }\n  .nl-modal[hidden] { display: none; }\n  .nl-panel {\n    position: relative;\n    max-width: min(92vw, 620px);\n    max-height: 92vh;\n    line-height: 0;\n  }\n  .nl-img {\n    display: block;\n    width: auto;\n    height: auto;\n    max-width: 100%;\n    max-height: 92vh;\n    border-radius: 10px;\n    background: #fbf5e6;\n  }\n  .nl-close {\n    position: absolute;\n    top: 8px;\n    right: 8px;\n    width: 32px;\n    height: 32px;\n    margin: 0;\n    padding: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: #F1E5C2;\n    color: #4a3512;\n    border: 1px solid #d9c896;\n    border-radius: 4px;\n    font-family: Arial, sans-serif;\n    font-size: 22px;\n    line-height: 1;\n    cursor: pointer;\n  }\n  .nl-close:hover { background: #ebdcae; }\n</style>\n\n<script>\n  (function () {\n    var openBtn = document.getElementById('nlOpen');\n    var closeBtn = document.getElementById('nlClose');\n    var modal = document.getElementById('nlModal');\n    if (!openBtn || !closeBtn || !modal) return;\n\n    function openModal() {\n      modal.hidden = false;\n      document.body.style.overflow = 'hidden';\n      closeBtn.focus();\n    }\n    function closeModal() {\n      modal.hidden = true;\n      document.body.style.overflow = '';\n      openBtn.focus();\n    }\n\n    openBtn.addEventListener('click', openModal);\n    closeBtn.addEventListener('click', closeModal);\n    modal.addEventListener('click', function (e) {\n      if (e.target === modal) closeModal();     // click on the dark backdrop\n    });\n    document.addEventListener('keydown', function (e) {\n      if (modal.hidden) return;\n      if (e.key === 'Escape') closeModal();\n      if (e.key === 'Tab') e.preventDefault();  // keep focus inside the popup\n    });\n  })();\n</script>"
          }
