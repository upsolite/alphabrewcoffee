        "custom_liquid_cpMQhc": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\" focusable=\"false\">\n  <defs>\n    <symbol id=\"ccStar\" viewBox=\"0 0 24 24\">\n      <path d=\"M12 2.2l2.9 6.2 6.8.8-5 4.7 1.3 6.7L12 17.2 6 20.6l1.3-6.7-5-4.7 6.8-.8z\"/>\n    </symbol>\n  </defs>\n</svg>\n\n<div class=\"cc-wrap\">\n  <div class=\"cc-bar\">\n\n    <div class=\"cc-stars\" role=\"img\" aria-label=\"Rated 4.7 out of 5\">\n      <div class=\"cc-row cc-empty\">\n        <svg class=\"cc-star\"><use href=\"#ccStar\"/></svg>\n        <svg class=\"cc-star\"><use href=\"#ccStar\"/></svg>\n        <svg class=\"cc-star\"><use href=\"#ccStar\"/></svg>\n        <svg class=\"cc-star\"><use href=\"#ccStar\"/></svg>\n        <svg class=\"cc-star\"><use href=\"#ccStar\"/></svg>\n      </div>\n      <!-- Fill width = rating ÷ 5 × 100  (4.7 → 94%) -->\n      <div class=\"cc-fill\" style=\"width: 94%;\">\n        <div class=\"cc-row cc-full\">\n          <svg class=\"cc-star\"><use href=\"#ccStar\"/></svg>\n          <svg class=\"cc-star\"><use href=\"#ccStar\"/></svg>\n          <svg class=\"cc-star\"><use href=\"#ccStar\"/></svg>\n          <svg class=\"cc-star\"><use href=\"#ccStar\"/></svg>\n          <svg class=\"cc-star\"><use href=\"#ccStar\"/></svg>\n        </div>\n      </div>\n    </div>\n\n    <p class=\"cc-label\"><strong>100k+ Vitalized Men</strong></p>\n\n    <div class=\"cc-faces\">\n      <span class=\"cc-av\"><img src=\"https://cdn.shopify.com/s/files/1/0653/0908/1645/files/alpha_customer_1_300x300_df6404f1-c120-43cd-9e63-4346b1f37467.jpg?v=1791769535\" alt=\"Happy customer\" loading=\"lazy\"></span>\n      <span class=\"cc-av\"><img src=\"https://cdn.shopify.com/s/files/1/0653/0908/1645/files/alpha_customer_2_300x300_62d2acff-0ea8-4205-b11c-6cd918d2020a.jpg?v=1791769535\" alt=\"Happy customer\" loading=\"lazy\"></span>\n      <span class=\"cc-av\"><img src=\"https://cdn.shopify.com/s/files/1/0653/0908/1645/files/alpha_customer_3_300x300_3e3faacb-1e78-4179-a972-4674084a7b1d.jpg?v=1791769535\" alt=\"Happy customer\" loading=\"lazy\"></span>\n      <span class=\"cc-av\"><img src=\"https://cdn.shopify.com/s/files/1/0653/0908/1645/files/bearded_man_forest_300x300_c316528e-de45-4621-bd1c-77f16455e51b.jpg?v=1791770304\" alt=\"Happy customer\" loading=\"lazy\"></span>\n      <span class=\"cc-av\"><img src=\"https://cdn.shopify.com/s/files/1/0653/0908/1645/files/Doctor_s_Clinic_Selfie.png?v=1791769538\" alt=\"Happy customer\" loading=\"lazy\"></span>\n    </div>\n\n  </div>\n</div>\n\n<style>\n  .cc-wrap,\n  .cc-wrap * {\n    box-sizing: border-box;\n  }\n  .cc-wrap {\n    --cc-gold: #B98141;             /* star color */\n    --cc-gray: #e2e2e2;             /* empty star color */\n    --cc-star: clamp(11px, 3.8vw, 24px);  /* star size, scales with screen width */\n    --cc-face: clamp(16px, 5.4vw, 32px);  /* face circle size, scales with screen width */\n    width: 100%;\n    padding: 10px 8px;\n    color: #111111;\n  }\n  .cc-bar {\n    display: flex;\n    align-items: center;\n    justify-content: center;        /* use flex-start to align left */\n    flex-wrap: nowrap;\n    gap: clamp(4px, 1.6vw, 12px);\n  }\n\n  /* Stars */\n  .cc-stars {\n    position: relative;\n    flex: none;\n    width: calc(var(--cc-star) * 5);\n    height: var(--cc-star);\n  }\n  .cc-row {\n    display: flex;\n    width: calc(var(--cc-star) * 5);\n  }\n  .cc-star {\n    flex: none;\n    width: var(--cc-star);\n    height: var(--cc-star);\n    display: block;\n  }\n  .cc-empty { color: var(--cc-gray); }\n  .cc-full  { color: var(--cc-gold); }\n  .cc-star use { fill: currentColor; }\n  .cc-fill {\n    position: absolute;\n    top: 0;\n    left: 0;\n    height: 100%;\n    overflow: hidden;\n  }\n\n  /* Text */\n  .cc-label {\n    flex: none;\n    margin: 0;\n    font-family: inherit;\n    font-size: clamp(9px, 3.4vw, 19px);\n    line-height: 1.2;\n    white-space: nowrap;\n    color: #111111;\n  }\n  .cc-label strong { font-weight: 700; }\n\n  /* Faces */\n  .cc-faces {\n    flex: none;\n    display: flex;\n    align-items: center;\n  }\n  .cc-av {\n    flex: none;\n    width: var(--cc-face);\n    height: var(--cc-face);\n    margin-left: calc(var(--cc-face) * -0.27);\n    border: 2px solid #ffffff;      /* outline so overlapping faces stay separated */\n    border-radius: 50%;\n    overflow: hidden;\n    background: #d9cfae;\n  }\n  .cc-av:first-child { margin-left: 0; }\n  .cc-av img {\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: 50% 30%;       /* keeps faces near the top of the circle */\n  }\n</style>"
          }
