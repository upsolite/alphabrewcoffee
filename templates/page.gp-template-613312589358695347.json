        "ggHkXWSw0_Y_srcSet_desktop_src": "https://placehold.co/512x512?text=Image",
        "ggI4jdCtr2h_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0653/0908/1645/files/Gemini_Generated_Image_ys02blys02blys02.png",
