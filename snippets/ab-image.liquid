{% comment %}
  Image from a theme editor setting, falling back to a theme asset when the setting is empty.
  Accepts: image, fallback, size, w, h, alt, class, eager
{% endcomment %}
{%- liquid
  assign ab_src = ''
  if image != blank
    assign ab_src = image | image_url: width: size
  elsif fallback != blank
    assign ab_src = fallback | asset_url
  endif
-%}
{%- if ab_src != '' -%}
  <img{% if class %} class="{{ class }}"{% endif %} src="{{ ab_src }}" alt="{{ alt | escape }}" width="{{ w }}" height="{{ h }}"{% if eager %} fetchpriority="high"{% else %} loading="lazy"{% endif %}>
{%- endif -%}
