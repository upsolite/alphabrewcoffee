<div class="ab-sec">
  <section class="ab-taste">
    <h2 class="ab-h ab-h--32">{{ section.settings.heading | escape }}{% if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent | escape }}</em>{% endif %}</h2>
    {%- render 'ab-image', image: section.settings.image, fallback: 'ab-hot-iced.jpg', size: 700, w: 642, h: 600, alt: section.settings.image_alt, class: 'ab-taste__img' -%}
    <div class="ab-taste__cols">
      {%- for block in section.blocks -%}
        {%- liquid
  assign fallback = ''
  if block.id contains 'ab_'
    assign fallback = block.id | replace: '_', '-' | append: '.svg'
  endif
-%}
        <div {{ block.shopify_attributes }}>
          {%- render 'ab-image', image: block.settings.icon, fallback: fallback, size: 96, w: 44, h: 48, alt: '' -%}
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
          <blockquote>{{ block.settings.quote | escape }}</blockquote>
          <small>{{ block.settings.author | escape }}</small>
        </div>
      {%- endfor -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "AB test: taste",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AB test: taste"
    }
  ]
}
{% endschema %}
