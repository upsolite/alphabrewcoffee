<div class="ab-sec">
  <section class="ab-ing">
    <h2 class="ab-h ab-h--30">{{ section.settings.heading | escape }}{% if section.settings.heading_accent != blank %} {{ section.settings.heading_accent | escape }}{% endif %}</h2>
    <p class="ab-sub-copy">{{ section.settings.subtext | escape }}</p>
    <div class="ab-ing__list" data-ab-ing>
      {%- for block in section.blocks -%}
        {%- liquid
  assign fallback = ''
  if block.id contains 'ab_'
    assign fallback = block.id | replace: '_', '-' | append: '.jpg'
  endif
-%}
        <article class="ab-ing__card{% if forloop.index > 4 %} is-extra{% endif %}" {{ block.shopify_attributes }}>
          <div class="ab-ing__top">
            <span class="ab-ing__img">
              {%- if block.settings.image_nc != blank -%}
                {%- render 'ab-image', image: block.settings.image, fallback: fallback, size: 128, w: 64, h: 64, alt: '', class: 'ab-caf-only' -%}
                {%- render 'ab-image', image: block.settings.image_nc, size: 128, w: 64, h: 64, alt: '', class: 'ab-nc-only' -%}
              {%- else -%}
                {%- render 'ab-image', image: block.settings.image, fallback: fallback, size: 128, w: 64, h: 64, alt: '' -%}
              {%- endif -%}
            </span>
            <h3>{% render 'ab-swap', text: block.settings.name, text_nc: block.settings.name_nc %}</h3>
          </div>
          <p class="ab-ing__copy">{% render 'ab-swap', text: block.settings.copy, text_nc: block.settings.copy_nc %}</p>
          <p class="ab-ing__dose">{% render 'ab-swap', text: block.settings.dose, text_nc: block.settings.dose_nc %}</p>
        </article>
      {%- endfor -%}
    </div>
    {%- if section.blocks.size > 4 -%}
      <button type="button" class="ab-ing__more" data-ab-ing-toggle data-more="{{ section.settings.show_all_label | escape }}" data-less="{{ section.settings.show_less_label | escape }}" aria-expanded="false">
        <span data-ab-ing-label>{{ section.settings.show_all_label | escape }}</span>
        <img src="{{ 'ab-chevron.svg' | asset_url }}" alt="" width="18" height="18">
      </button>
    {%- endif -%}
    <button type="button" class="ab-block-btn" style="border-radius: 10px !important;" data-ab-sheet-open>{{ section.settings.button_label | escape }}</button>
  </section>
</div>

{% schema %}
{
  "name": "AB test: ingredients",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext"
    },
    {
      "type": "text",
      "id": "show_all_label",
      "label": "Show all label"
    },
    {
      "type": "text",
      "id": "show_less_label",
      "label": "Show less label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Supplement Facts button"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "copy",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "dose",
          "label": "Dose"
        },
        {
          "type": "header",
          "content": "No Caffeine (leave empty to keep the same)"
        },
        {
          "type": "image_picker",
          "id": "image_nc",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "name_nc",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "copy_nc",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "dose_nc",
          "label": "Dose"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AB test: ingredients"
    }
  ]
}
{% endschema %}
