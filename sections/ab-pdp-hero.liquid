{% comment %}
  A/B test (Elevate, mobile only): rotating banner, gallery, review strip and buy box.
  Used only by templates/product.ab-*.json. Control (product.json) never loads this.

  Prices come from Shopify: one-time = variant price x quantity,
  subscription = selling plan allocation x quantity.
{% endcomment %}

{{ 'ab-pdp.css' | asset_url | stylesheet_tag }}
{{ 'ab-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ab-pdp.js' | asset_url }}" defer></script>

{%- liquid
  assign slides = section.blocks | where: 'type', 'slide'
  assign plans = product.selling_plan_groups.first.selling_plans
  assign titles = 'Buy 1|Buy 2, Get 1 Free|Buy 3, Get 2 Free' | split: '|'
  assign quantities = '1,3,5' | split: ','
  assign sub_lines = '1 bag, every month|3 bags, every 3 months|5 bags, every 5 months' | split: '|'
  assign one_lines = '1 bag, one-time delivery|3 bags, one-time delivery|5 bags, one-time delivery' | split: '|'
  assign badges = '|BEST RESULTS|BEST VALUE' | split: '|'
  assign pack_files = 'ab-pack-1.png,ab-pack-3.png,ab-pack-5.png' | split: ','

  # Products with a "Caffeine" option get the Caffeine / No Caffeine selector.
  # Variants are matched by option value, so option order doesn't matter.
  assign base_option = nil
  assign base_pos = -1
  assign bundle_option = nil
  assign bundle_pos = 0
  for option in product.options_with_values
    if option.name == 'Caffeine'
      assign base_option = option
      assign base_pos = forloop.index0
    elsif bundle_option == nil
      assign bundle_option = option
      assign bundle_pos = forloop.index0
    endif
  endfor
  assign has_bases = false
  if base_option and base_option.values.size > 1
    assign has_bases = true
  endif
-%}

<link rel="preload" href="{{ 'ab-cart.css' | asset_url }}" as="style">
<div class="ab-pdp" data-ab-pdp data-ab-test="{{ template.suffix }}">
  {% comment %}
    Kaching's app embed attaches to the first product form on the page. The buy box
    here adds to cart itself, so this hidden form gives Kaching somewhere to attach.
    Without it, Kaching takes over the theme's free-product form in layout/theme.liquid
    and the cart drawer adds extra bags. Never submitted.
  {% endcomment %}
  {%- form 'product', product, class: 'form ab-kaching-anchor', hidden: 'hidden', data-type: 'add-to-cart-form' -%}
    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" class="product-variant-id">
    <button type="submit" name="add" tabindex="-1" hidden></button>
  {%- endform -%}

  <div class="ab-banner" data-ab-banner>
    <button type="button" class="ab-banner__nav" data-ab-banner-prev aria-label="Previous message">‹</button>
    <div class="ab-banner__msgs" aria-live="polite">
      {%- assign messages = section.blocks | where: 'type', 'banner' -%}
      {%- for block in messages -%}
        <p class="ab-banner__msg{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
      {%- endfor -%}
    </div>
    <button type="button" class="ab-banner__nav" data-ab-banner-next aria-label="Next message">›</button>
  </div>

  <div class="ab-gallery" data-ab-gallery>
    <div class="ab-gallery__track" data-ab-track>
      {%- for block in slides -%}
        {%- liquid
          assign fallback = ''
          if block.id contains 'ab_'
            assign fallback = block.id | replace: '_', '-' | append: '.jpg'
          endif
        -%}
        {%- liquid
          assign swap = false
          if has_bases
            if block.settings.nc_image != blank or block.settings.nc_version
              assign swap = true
            endif
          endif
          assign nc_fallback = ''
          if swap and block.settings.nc_version and fallback != ''
            assign nc_fallback = fallback | replace: '.jpg', '-nc.jpg'
          endif
        -%}
        <button type="button" class="ab-gallery__slide{% if has_bases and block.settings.nc_hide %} ab-caf-only{% endif %}" data-ab-slide="{{ forloop.index0 }}" aria-label="Open image {{ forloop.index }}" {{ block.shopify_attributes }}>
          {%- if swap -%}
            {%- render 'ab-image', image: block.settings.image, fallback: fallback, size: 1060, w: 786, h: 786, alt: block.settings.alt, eager: forloop.first, class: 'ab-caf-only' -%}
            {%- render 'ab-image', image: block.settings.nc_image, fallback: nc_fallback, size: 1060, w: 786, h: 786, alt: block.settings.alt, class: 'ab-nc-only' -%}
          {%- else -%}
            {%- render 'ab-image', image: block.settings.image, fallback: fallback, size: 1060, w: 786, h: 786, alt: block.settings.alt, eager: forloop.first -%}
          {%- endif -%}
        </button>
      {%- endfor -%}
    </div>
  </div>

  <div class="ab-body">
    <div class="ab-thumbs" data-ab-thumbs>
      {%- for block in slides -%}
        {%- liquid
          assign fallback = ''
          if block.id contains 'ab_'
            assign fallback = block.id | replace: '_', '-' | replace: 'slide', 'thumb' | append: '.jpg'
          endif
        -%}
        {%- liquid
          assign swap = false
          if has_bases
            if block.settings.nc_image != blank or block.settings.nc_version
              assign swap = true
            endif
          endif
          assign nc_fallback = ''
          if swap and block.settings.nc_version and fallback != ''
            assign nc_fallback = fallback | replace: '.jpg', '-nc.jpg'
          endif
        -%}
        <button type="button" class="ab-thumb{% if forloop.first %} is-active{% endif %}{% if has_bases and block.settings.nc_hide %} ab-caf-only{% endif %}" style="border-radius: 6px !important;" data-ab-thumb="{{ forloop.index0 }}" aria-label="Show image {{ forloop.index }}">
          {%- if swap -%}
            {%- render 'ab-image', image: block.settings.image, fallback: fallback, size: 240, w: 53, h: 53, alt: '', class: 'ab-caf-only' -%}
            {%- render 'ab-image', image: block.settings.nc_image, fallback: nc_fallback, size: 240, w: 53, h: 53, alt: '', class: 'ab-nc-only' -%}
          {%- else -%}
            {%- render 'ab-image', image: block.settings.image, fallback: fallback, size: 240, w: 53, h: 53, alt: '' -%}
          {%- endif -%}
        </button>
      {%- endfor -%}
    </div>

    <div class="ab-strip">
      {%- capture stars -%}
        <span class="ab-stars" aria-label="5 out of 5 stars">
          {%- for i in (1..5) -%}<img src="{{ 'ab-star.svg' | asset_url }}" alt="" width="14" height="14">{%- endfor -%}
        </span>
      {%- endcapture -%}
      {%- capture verified -%}<img src="{{ 'ab-verified.svg' | asset_url }}" alt="" width="12" height="12">{%- endcapture -%}
      {%- assign strip_reviews = section.blocks | where: 'type', 'strip_review' -%}
      {%- for block in strip_reviews -%}
        <div class="ab-strip__card" {{ block.shopify_attributes }}><p>{{ block.settings.text }}</p><div class="ab-strip__foot">{{ stars }}<span>{{ verified }} {{ block.settings.author | escape }}</span></div></div>
      {%- endfor -%}
    </div>

    <button type="button" class="ab-rating" data-ab-scroll="#ab-reviews">
      <span class="ab-rating__faces">
        {%- for i in (1..3) -%}
          {%- assign face_key = 'face_' | append: i -%}
          {%- assign face_file = 'ab-face-' | append: i | append: '.jpg' -%}
          {%- render 'ab-image', image: section.settings[face_key], fallback: face_file, size: 64, w: 21, h: 21, alt: '', eager: true -%}
        {%- endfor -%}
      </span>
      {{ stars }}
      <span class="ab-rating__text">{{ section.settings.rating_text | escape }}</span>
    </button>

    <h1 class="ab-title">
      {%- if has_bases and section.settings.title_nc != blank -%}
        <span class="ab-caf-only">{{ section.settings.title | escape }}</span><span class="ab-nc-only">{{ section.settings.title_nc | escape }}</span>
      {%- else -%}
        {{ section.settings.title | escape }}
      {%- endif -%}
    </h1>

    <button type="button" class="ab-label-link" data-ab-sheet-open>
      {{ section.settings.label_link | escape }}
      <svg width="9" height="9" viewBox="0 0 10.2 9.6" fill="none" aria-hidden="true"><path d="M9.54 6.69V.67H3.12" stroke="#4A3512" stroke-width="1.33" stroke-linecap="square"/><path d="M.94 8.67 8.86 1.3" stroke="#4A3512" stroke-width="1.33" stroke-linecap="square"/></svg>
    </button>

    <p class="ab-desc">
      {%- if has_bases and section.settings.description_nc != blank -%}
        <span class="ab-caf-only">{{ section.settings.description }}</span><span class="ab-nc-only">{{ section.settings.description_nc }}</span>
      {%- else -%}
        {{ section.settings.description }}
      {%- endif -%}
    </p>

    <ul class="ab-bullets">
      {%- for i in (1..4) -%}
        {%- assign key = 'bullet_' | append: i -%}
        {%- if section.settings[key] != blank -%}
          {%- assign key_nc = key | append: '_nc' -%}
          <li><img src="{{ 'ab-check.svg' | asset_url }}" alt="" width="15" height="15">
            {%- if has_bases and section.settings[key_nc] != blank -%}
              <span class="ab-caf-only">{{ section.settings[key] | escape }}</span><span class="ab-nc-only">{{ section.settings[key_nc] | escape }}</span>
            {%- else -%}
              {{ section.settings[key] | escape }}
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    <p class="ab-heading">{{ section.settings.base_heading | escape }}</p>
    {%- if has_bases -%}
      <div class="ab-bases" role="radiogroup" aria-label="{{ section.settings.base_heading | escape }}">
        <label class="ab-base is-selected" data-ab-base>
          <input type="radio" name="ab-base" value="{{ base_option.values[0] | escape }}" checked>
          <strong>{{ section.settings.base_title | escape }}</strong>
          <span>{{ section.settings.base_subtitle | escape }}</span>
        </label>
        <label class="ab-base" data-ab-base data-nc>
          <input type="radio" name="ab-base" value="{{ base_option.values[1] | escape }}">
          <strong>{{ section.settings.base_nc_title | escape }}</strong>
          <span>{{ section.settings.base_nc_subtitle | escape }}</span>
        </label>
      </div>
    {%- else -%}
      <div class="ab-base">
        <strong>{{ section.settings.base_title | escape }}</strong>
        <span>{{ section.settings.base_subtitle | escape }}</span>
      </div>
    {%- endif -%}

    <div class="ab-plan-row">
      <p class="ab-heading ab-heading--plan"><span class="ab-sub">Subscribe &amp; Save</span><span class="ab-one">One-Time Purchase</span></p>
      {%- if section.settings.stock_note != blank -%}
        <p class="ab-stock"><span aria-hidden="true"></span>{{ section.settings.stock_note | escape }}</p>
      {%- endif -%}
    </div>

    <div class="ab-cards" role="radiogroup" aria-label="Choose your bundle" data-ab-cards>
      {%- for title in titles -%}
        {%- liquid
          assign i = forloop.index0
          assign bundle_value = bundle_option.values[i]
          assign v = nil
          assign variant_map = ''
          for candidate in product.variants
            if candidate.options[bundle_pos] == bundle_value
              if has_bases
                assign base_value = candidate.options[base_pos]
                assign variant_map = variant_map | append: ',"' | append: base_value | append: '":' | append: candidate.id
                if base_value == base_option.values[0]
                  assign v = candidate
                endif
              elsif v == nil
                assign v = candidate
              endif
            endif
          endfor
          assign variant_map = variant_map | remove_first: ',' | prepend: '{' | append: '}'
          assign pack_key = 'pack_' | append: forloop.index
          if section.settings[pack_key] != blank
            assign pack_url = section.settings[pack_key] | image_url: width: 240
          else
            assign pack_url = pack_files[i] | asset_url
          endif
          assign qty = quantities[i] | plus: 0
          assign plan = plans[i]
          assign alloc = nil
          for a in v.selling_plan_allocations
            if a.selling_plan.id == plan.id
              assign alloc = a
              break
            endif
          endfor
          assign cups = qty | times: 30.0
          assign sub_total = alloc.price | times: qty
          assign one_total = v.price | times: qty
          assign compare_total = v.compare_at_price | times: qty
          assign sub_save = compare_total | minus: sub_total | divided_by: 100.0 | round | times: 100
          assign one_save = compare_total | minus: one_total | divided_by: 100.0 | round | times: 100
          assign sub_cup = sub_total | divided_by: cups | round
          assign one_cup = one_total | divided_by: cups | round
          assign is_default = false
          if i == 1
            assign is_default = true
          endif
        -%}
        <label
          class="ab-card{% if is_default %} is-selected{% endif %}"
          data-ab-card
          data-variant="{{ v.id }}"
          {% if has_bases %}data-variants="{{ variant_map | escape }}"{% endif %}
          data-plan="{{ plan.id }}"
          data-qty="{{ qty }}"
          data-title="{{ title | escape }}"
          data-pack="{{ pack_url }}"
          data-sub="{{ sub_total | money }}"
          data-one="{{ one_total | money }}"
          data-compare="{{ compare_total | money }}"
        >
          <input type="radio" name="ab-bundle" value="{{ i }}"{% if is_default %} checked{% endif %}>
          <span class="ab-card__radio" aria-hidden="true"></span>
          <span class="ab-card__pack"><img src="{{ pack_url }}" alt="" width="52" height="52" loading="lazy"></span>
          <span class="ab-card__main">
            <span class="ab-card__title">{{ title }}</span>
            <span class="ab-card__save"><span class="ab-sub">Save {{ sub_save | money_without_trailing_zeros }}</span><span class="ab-one">Save {{ one_save | money_without_trailing_zeros }}</span></span>
            <span class="ab-card__line"><span class="ab-sub">{{ sub_lines[i] }}</span><span class="ab-one">{{ one_lines[i] }}</span></span>
          </span>
          <span class="ab-card__prices">
            <span class="ab-card__price"><span class="ab-sub">{{ sub_total | money }}</span><span class="ab-one">{{ one_total | money }}</span></span>
            <s class="ab-card__compare">{{ compare_total | money }}</s>
            <span class="ab-card__cup"><span class="ab-sub">{{ sub_cup | money }} / cup</span><span class="ab-one">{{ one_cup | money }} / cup</span></span>
          </span>
          {%- if badges[i] != blank -%}<span class="ab-card__badge">{{ badges[i] }}</span>{%- endif -%}
        </label>
      {%- endfor -%}
    </div>

    <button type="button" class="ab-mode" data-ab-mode>
      <span class="ab-sub">{% render 'ab-arrow', dir: 'right' %}<u>Try it Once - No Autoship (<span data-ab-one-price></span>)</u></span>
      <span class="ab-one">{% render 'ab-arrow', dir: 'left' %}<u>Back to Subscribe &amp; Save (save up to 67%)</u></span>
    </button>

    <div class="ab-ship">
      <img src="{{ 'ab-truck.svg' | asset_url }}" alt="" width="18" height="18">
      <span data-ab-delivery><b>Free shipping on every bundle</b></span>
    </div>

    <button type="button" class="ab-atc" data-ab-atc>
      <span class="ab-atc__label" data-ab-atc-label>Add To Cart</span>
      <span class="ab-atc__sub" data-ab-atc-sub>90-Day Money-Back Guarantee</span>
    </button>
    <p class="ab-error" data-ab-error role="alert" hidden></p>

    <p class="ab-secure"><span class="ab-sub">{{ section.settings.trust_line | escape }}</span><span class="ab-one">One-time purchase · No subscription</span></p>

    <div class="ab-pay">
      {%- for block in section.blocks -%}
        {%- if block.type == 'payment_icons' -%}{%- render 'payment-icons', block: block -%}{%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="ab-sticky" data-ab-sticky aria-hidden="true">
    <span class="ab-sticky__pack"><img data-ab-sticky-pack src="{{ pack_files[1] | asset_url }}" alt="" width="46" height="46"></span>
    <span class="ab-sticky__main">
      <span class="ab-sticky__title"><b data-ab-sticky-title></b>{% if has_bases %}<span class="ab-nc-only"> · {{ section.settings.base_nc_title | escape }}</span>{% endif %}</span>
      <span><b class="ab-sticky__price" data-ab-sticky-price></b> <s data-ab-sticky-compare></s></span>
    </span>
    <button type="button" class="ab-sticky__btn" data-ab-atc tabindex="-1"><span data-ab-atc-label>Add To Cart</span></button>
  </div>

  <div class="ab-sheet" data-ab-sheet role="dialog" aria-modal="true" aria-label="Supplement Facts" hidden>
    <div class="ab-sheet__panel" data-ab-sheet-panel>
      <div class="ab-sheet__handle" data-ab-sheet-handle></div>
      <div class="ab-sheet__head"><b>{{ section.settings.sheet_title | escape }}</b><button type="button" data-ab-sheet-close aria-label="Close">×</button></div>
      {%- if has_bases -%}
        {%- render 'ab-image', image: section.settings.label_image, fallback: 'ab-slide-06.jpg', size: 1060, w: 786, h: 786, alt: section.settings.sheet_title, class: 'ab-caf-only' -%}
        {%- render 'ab-image', image: section.settings.label_image_nc, fallback: 'ab-label-nc.jpg', size: 1060, w: 786, h: 818, alt: section.settings.sheet_title, class: 'ab-nc-only' -%}
        <p><span class="ab-caf-only">{{ section.settings.sheet_caption | newline_to_br }}</span><span class="ab-nc-only">{{ section.settings.sheet_caption_nc | newline_to_br }}</span></p>
      {%- else -%}
        {%- render 'ab-image', image: section.settings.label_image, fallback: 'ab-slide-06.jpg', size: 1060, w: 786, h: 786, alt: section.settings.sheet_title -%}
        <p>{{ section.settings.sheet_caption | newline_to_br }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

