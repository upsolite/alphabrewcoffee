    },
    {
      "type": "textarea",
      "id": "sheet_caption",
      "label": "Nutrition sheet caption"
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message"
        }
      ]
    },
    {
      "type": "slide",
      "name": "Gallery slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
