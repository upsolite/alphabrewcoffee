{{ 'bars-stacks.css' | asset_url | stylesheet_tag }}

<div class="bars-stacks">
  <div class="bars-stacks__container">
    <div class="bars-stacks__item-tabs">
      <div class="bars-stacks__item-tab bars-stacks__item-tab--active" role="button" tab-for="expect">
        <h2>What to expect</h2>
      </div>
      <div class="bars-stacks__item-tab" role="button" tab-for="faq">
        <h2>FAQ's</h2>
      </div>
      <div class="bars-stacks__item-tab" role="button" tab-for="reviews">
        <h2>Reviews</h2>
      </div>
    </div>

    <div class="bars-stacks__item-content">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'expect' %}
            {% comment %} Block #1 {% endcomment %}
            <div class="bars-stacks__item-content-item bars-stacks__item-content-item--active" tab="expect">
              <h2>{{ block.settings.title }}</h2>
              <div class="bars-stacks__item-content-blocks">
                <div class="bars-stacks__item-content-block">
                  <div class="bars-stacks__item-content-block__icon">
                    <span class="bars-stacks__item-content-block__icon__icon">
                      {% if block.settings.block_1_image != blank %}
                        <img
                          src="{{ block.settings.block_1_image | image_url: width: 100 }}"
                          alt="{{ block.settings.block_1_title }}"
                          width="100"
                          height="100"
                        >
                      {% else %}
                        {% render 'icon-speed-effect' %}
                      {% endif %}
                    </span>
                    <div class="bars-stacks__item-content-block__icon__title">
                      <p>DAY 7</p>
                      <h3>{{ block.settings.block_1_title }}</h3>
                    </div>
                  </div>
                  <div class="bars-stacks__item-content-block__list">
                    {{ block.settings.block_1_description }}
                  </div>
                </div>

                <div class="bars-stacks__item-content-block">
                  <div class="bars-stacks__item-content-block__icon">
                    <span class="bars-stacks__item-content-block__icon__icon">
                      {% if block.settings.block_1_image != blank %}
                        <img
                          src="{{ block.settings.block_1_image | image_url: width: 100 }}"
                          alt="{{ block.settings.block_1_title }}"
                          width="100"
                          height="100"
                        >
                      {% else %}
                        {% render 'icon-speed-effect' %}
                      {% endif %}
                    </span>
                    <div class="bars-stacks__item-content-block__icon__title">
                      <p>DAY 7</p>
                      <h3>{{ block.settings.block_2_title }}</h3>
                    </div>
                  </div>
                  <div class="bars-stacks__item-content-block__list">
                    {{ block.settings.block_2_description }}
                  </div>
                </div>
                <div class="bars-stacks__item-content-block">
                  <div class="bars-stacks__item-content-block__icon">
                    <span class="bars-stacks__item-content-block__icon__icon">
                      {% if block.settings.block_1_image != blank %}
                        <img
                          src="{{ block.settings.block_1_image | image_url: width: 100 }}"
                          alt="{{ block.settings.block_1_title }}"
                          width="100"
                          height="100"
                        >
                      {% else %}
                        {% render 'icon-speed-effect' %}
                      {% endif %}
                    </span>
                    <div class="bars-stacks__item-content-block__icon__title">
                      <p>DAY 7</p>
                      <h3>{{ block.settings.block_3_title }}</h3>
                    </div>
                  </div>
                  <div class="bars-stacks__item-content-block__list">
                    {{ block.settings.block_3_description }}
                  </div>
                </div>
              </div>
            </div>
          {% when 'faq' %}
            {% comment %} Block #2 {% endcomment %}
            <div class="bars-stacks__item-content-item" tab="faq">
              <div class="bars-stacks__item-content-accordion">
                <div class="bars-stacks__item-content-accordion__item">
                  <div class="bars-stacks__item-content-accordion__item__question">
                    <h3>{{ block.settings.faq_1_question }}</h3>
                    <span class="bars-stacks__item-content-accordion__item__question__icon">
                      {% render 'icon-chevron' %}
                    </span>
                  </div>
                  <div class="bars-stacks__item-content-accordion__item__answer">
                    <div class="force-padding">
                      {{ block.settings.faq_1_answer }}
                    </div>
                  </div>
                </div>

                <div class="bars-stacks__item-content-accordion__item">
                  <div class="bars-stacks__item-content-accordion__item__question">
                    <h3>{{ block.settings.faq_2_question }}</h3>
                    <span class="bars-stacks__item-content-accordion__item__question__icon">
                      {% render 'icon-chevron' %}
                    </span>
                  </div>
                  <div class="bars-stacks__item-content-accordion__item__answer">
                    <div class="force-padding">
                      {{ block.settings.faq_2_answer }}
                    </div>
                  </div>
                </div>

                <div class="bars-stacks__item-content-accordion__item">
                  <div class="bars-stacks__item-content-accordion__item__question">
                    <h3>{{ block.settings.faq_3_question }}</h3>
                    <span class="bars-stacks__item-content-accordion__item__question__icon">
                      {% render 'icon-chevron' %}
                    </span>
                  </div>
                  <div class="bars-stacks__item-content-accordion__item__answer">
                    <div class="force-padding">
                      {{ block.settings.faq_3_answer }}
                    </div>
                  </div>
                </div>

                <div class="bars-stacks__item-content-accordion__item">
                  <div class="bars-stacks__item-content-accordion__item__question">
                    <h3>{{ block.settings.faq_4_question }}</h3>
                    <span class="bars-stacks__item-content-accordion__item__question__icon">
                      {% render 'icon-chevron' %}
                    </span>
                  </div>
                  <div class="bars-stacks__item-content-accordion__item__answer">
                    <div class="force-padding">
                      {{ block.settings.faq_4_answer }}
                    </div>
                  </div>
                </div>

                <div class="bars-stacks__item-content-accordion__item">
                  <div class="bars-stacks__item-content-accordion__item__question">
                    <h3>{{ block.settings.faq_5_question }}</h3>
                    <span class="bars-stacks__item-content-accordion__item__question__icon">
                      {% render 'icon-chevron' %}
                    </span>
                  </div>
                  <div class="bars-stacks__item-content-accordion__item__answer">
                    <div class="force-padding">
                      {{ block.settings.faq_5_answer }}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          {% when 'reviews' %}
            {% comment %} Block #3 {% endcomment %}
            <div class="bars-stacks__item-content-item" tab="reviews">
              <div class="bars-stacks__item-content-reviews">
                <div class="bars-stacks__item-content-review">
                  <div class="bars-stacks__item-content-review-header">
                    <div class="bars-stacks__item-content-review-stars">
                      <strong>★★★★★</strong>
                    </div>
                    <h3 class="bars-stacks__item-content-review-title">“{{ block.settings.review_1_title }}”</h3>
                  </div>
                  <div class="bars-stacks__item-content-review-content">
                    <p class="bars-stacks__item-content-review-text">{{ block.settings.review_1_text }}</p>
                    <div class="bars-stacks__item-content-review-author">
                      <span class="bars-stacks__item-content-review-author-name"
                        >- {{ block.settings.review_1_author -}}
                      </span>
                      <div class="bars-stacks__item-content-review-author-verified">
                        {% render 'icon-verified' %}
                        <span> Verified Buyer </span>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="bars-stacks__item-content-review">
                  <div class="bars-stacks__item-content-review-header">
                    <div class="bars-stacks__item-content-review-stars">
                      <strong>★★★★★</strong>
                    </div>
                    <h3 class="bars-stacks__item-content-review-title">“{{ block.settings.review_2_title }}”</h3>
                  </div>
                  <div class="bars-stacks__item-content-review-content">
                    <p class="bars-stacks__item-content-review-text">{{ block.settings.review_2_text }}</p>
                    <div class="bars-stacks__item-content-review-author">
                      <span class="bars-stacks__item-content-review-author-name"
                        >- {{ block.settings.review_2_author -}}
                      </span>
                      <div class="bars-stacks__item-content-review-author-verified">
                        {% render 'icon-verified' %}
                        <span> Verified Buyer </span>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="bars-stacks__item-content-review">
                  <div class="bars-stacks__item-content-review-header">
                    <div class="bars-stacks__item-content-review-stars">
                      <strong>★★★★★</strong>
                    </div>
                    <h3 class="bars-stacks__item-content-review-title">“{{ block.settings.review_3_title }}”</h3>
                  </div>
                  <div class="bars-stacks__item-content-review-content">
                    <p class="bars-stacks__item-content-review-text">{{ block.settings.review_3_text }}</p>
                    <div class="bars-stacks__item-content-review-author">
                      <span class="bars-stacks__item-content-review-author-name"
                        >- {{ block.settings.review_3_author -}}
                      </span>
                      <div class="bars-stacks__item-content-review-author-verified">
                        {% render 'icon-verified' %}
                        <span> Verified Buyer </span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>

<script defer="defer">
  document.querySelectorAll('.bars-stacks').forEach((section) => {
    const tabs = section.querySelectorAll('.bars-stacks__item-tab[tab-for]');
    const panels = section.querySelectorAll('.bars-stacks__item-content-item[tab]');
    const accordionItems = section.querySelectorAll('.bars-stacks__item-content-accordion__item');

    const closeAccordionItem = (item) => {
      const answer = item.querySelector('.bars-stacks__item-content-accordion__item__answer');

      if (!answer) return;

      item.classList.remove('bars-stacks__item-content-accordion__item--active');
      answer.style.height = '0px';
      answer.style.maxHeight = '0px';
    };

    const openAccordionItem = (item) => {
      const answer = item.querySelector('.bars-stacks__item-content-accordion__item__answer');

      if (!answer) return;

      accordionItems.forEach((accordionItem) => {
        if (accordionItem !== item) closeAccordionItem(accordionItem);
      });

      item.classList.add('bars-stacks__item-content-accordion__item--active');
      answer.style.height = `${answer.scrollHeight}px`;
      answer.style.maxHeight = `${answer.scrollHeight}px`;
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const selectedTab = tab.getAttribute('tab-for');

        tabs.forEach((item) => {
          item.classList.toggle('bars-stacks__item-tab--active', item === tab);
        });

        panels.forEach((panel) => {
          panel.classList.toggle('bars-stacks__item-content-item--active', panel.getAttribute('tab') === selectedTab);
        });
      });
    });

    accordionItems.forEach((item) => {
      const question = item.querySelector('.bars-stacks__item-content-accordion__item__question');

      closeAccordionItem(item);

      question?.addEventListener('click', () => {
        if (item.classList.contains('bars-stacks__item-content-accordion__item--active')) {
          closeAccordionItem(item);
          return;
        }

        openAccordionItem(item);
      });
    });
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.bars-stacks').forEach((section) => {
      const reviews = section.querySelectorAll('.bars-stacks__item-content-review');

      reviews.forEach((review) => {
        const header = review.querySelector('.bars-stacks__item-content-review-header');
        const content = review.querySelector('.bars-stacks__item-content-review-content');

        if (!header || !content) return;

        header.addEventListener('click', () => {
          review.classList.toggle('is-active');
        });
      });
    });
  });
</script>

