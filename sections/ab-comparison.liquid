<div class="ab-sec">
  <section class="ab-cmp">
    <h2 class="ab-h ab-h--30 ab-cmp__h">{{ section.settings.heading | escape }}{% if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent | escape }}</em>{% endif %}</h2>
    <p class="ab-sub-copy">{{ section.settings.subtext | escape }}</p>
    <div class="ab-cmp__table">
      <div class="ab-cmp__col ab-cmp__col--label">
        <div class="ab-cmp__head"></div>
        <div class="ab-cmp__body">
          {%- for block in section.blocks -%}<span {{ block.shopify_attributes }}>{% render 'ab-swap', text: block.settings.label, text_nc: block.settings.label_nc %}</span>{%- endfor -%}
        </div>
      </div>
      <div class="ab-cmp__brand">
        <div class="ab-cmp__brand-head"><em>{{ section.settings.brand_line_1 | escape }}</em><b>{{ section.settings.brand_line_2 | escape }}</b></div>
        {%- for block in section.blocks -%}
          {%- liquid
            assign brand_nc = block.settings.brand
            if block.settings.label_nc != blank
              assign brand_nc = block.settings.brand_nc
            endif
          -%}
          <span>{% render 'ab-check', value: block.settings.brand, value_nc: brand_nc, icon: 'ab-yes.svg' %}</span>
        {%- endfor -%}
      </div>
      <div class="ab-cmp__col">
        <div class="ab-cmp__head"><img src="{{ 'ab-coffee.svg' | asset_url }}" alt="" width="22" height="22"><b>{{ section.settings.column_2 | escape }}</b></div>
        <div class="ab-cmp__body ab-cmp__body--mid">
          {%- for block in section.blocks -%}
            {%- liquid
              assign col_nc = block.settings.column_2
              if block.settings.label_nc != blank
                assign col_nc = block.settings.column_2_nc
              endif
            -%}
            <span>{% render 'ab-check', value: block.settings.column_2, value_nc: col_nc, icon: 'ab-yes-dim.svg' %}</span>
          {%- endfor -%}
        </div>
      </div>
      <div class="ab-cmp__col">
        <div class="ab-cmp__head"><img src="{{ 'ab-mushroom.svg' | asset_url }}" alt="" width="22" height="22"><b>{{ section.settings.column_3 | escape }}</b></div>
        <div class="ab-cmp__body ab-cmp__body--end">
          {%- for block in section.blocks -%}
            {%- liquid
              assign col_nc = block.settings.column_3
              if block.settings.label_nc != blank
                assign col_nc = block.settings.column_3_nc
              endif
            -%}
            <span>{% render 'ab-check', value: block.settings.column_3, value_nc: col_nc, icon: 'ab-yes-dim.svg' %}</span>
          {%- endfor -%}
        </div>
      </div>
    </div>
    <button type="button" class="ab-cta" data-ab-scroll="[data-ab-cards]"><b>{{ section.settings.button_label | escape }}</b><small>{{ section.settings.button_sub | escape }}</small></button>
    <p class="ab-note">{{ section.settings.footnote | escape }}</p>
  </section>
</div>

{% schema %}
{
  "name": "AB test: comparison",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext"
    },
    {
      "type": "text",
      "id": "brand_line_1",
      "label": "Brand name, line 1"
    },
    {
      "type": "text",
      "id": "brand_line_2",
      "label": "Brand name, line 2"
    },
    {
      "type": "text",
      "id": "column_2",
      "label": "Column 2 name"
    },
    {
      "type": "text",
      "id": "column_3",
      "label": "Column 3 name"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "text",
      "id": "button_sub",
      "label": "Button small text"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "checkbox",
          "id": "brand",
          "label": "Alpha Brew has this",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "column_2",
          "label": "Column 2 has this",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "column_3",
          "label": "Column 3 has this",
          "default": false
        },
        {
          "type": "header",
          "content": "No Caffeine (when the label is filled in)"
        },
        {
          "type": "text",
          "id": "label_nc",
          "label": "Label"
        },
        {
          "type": "checkbox",
          "id": "brand_nc",
          "label": "Alpha Brew has this",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "column_2_nc",
          "label": "Column 2 has this",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "column_3_nc",
          "label": "Column 3 has this",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AB test: comparison"
    }
  ]
}
{% endschema %}
